# Copy to .env.local for local development, and add the same variables in
# Vercel (Project → Settings → Environment Variables) for production.

# Resend (https://resend.com) sends the contact form emails.
RESEND_API_KEY=
# Where messages are delivered (your inbox). Kept out of the code on purpose.
CONTACT_TO_EMAIL=
# Sender address on a domain verified in Resend, e.g. "Portfolio <contact@jdtripp.com>".
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile) spam protection.
# For local testing, Cloudflare's "always passes" test keys work:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
